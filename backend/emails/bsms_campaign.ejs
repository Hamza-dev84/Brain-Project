<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
    }

    .card {
      max-width: 700px;
      margin: auto;
      background: #fff;
      padding: 20px;
      border-radius: 8px;
    }

    .title {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .row {
      margin: 10px 0;
    }

    .label {
      font-weight: bold;
      color: #333;
    }
  </style>
</head>
<body>

<div class="card">

  <div class="title">
    BSMS Campaign Form Submission
  </div>

  <div class="row">
    <span class="label">Full Name:</span>
    <%= fullName || '-' %>
  </div>

  <div class="row">
    <span class="label">Phone:</span>
    <%= phone || '-' %>
  </div>

  <div class="row">
    <span class="label">Referral:</span>
    <%= referral || '-' %>
  </div>

  <div class="row">
    <span class="label">SECP Registered:</span>
    <%= secpRegistered || '-' %>
  </div>

  <div class="row">
    <span class="label">SMS Required:</span>
    <%= smsRequired || 0 %>
  </div>

    <div class="row">
    <span class="label">Service:</span>
    <%= service || '-' %>
  </div>

  <div class="row">
    <span class="label">Frequency:</span>
    <%= frequency || '-' %>
  </div>

  <hr>

  <div class="row">
    Submitted On:
    <%= createdAt %>
  </div>

</div>

</body>
</html>