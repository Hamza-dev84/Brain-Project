<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
    }

    .card {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      padding: 20px;
      border-radius: 8px;
    }

    .title {
      font-size: 20px;
      font-weight: bold;
      color: #2c3e50;
      margin-bottom: 15px;
    }

    .row {
      margin: 8px 0;
    }

    .label {
      font-weight: bold;
    }
  </style>
</head>

<body>
  <div class="card">
    <div class="title">New BrainCloud Inquiry</div>

    <div class="row">
      <span class="label">Name:</span>
      <%= name || '-' %>
    </div>

    <div class="row">
      <span class="label">Email:</span>
      <%= email || '-' %>
    </div>

    <div class="row">
      <span class="label">Phone:</span>
      <%= phone || '-' %>
    </div>

    <div class="row">
      <span class="label">Company:</span>
      <%= company || '-' %>
    </div>

    <div class="row">
      <span class="label">Service:</span>
      <%= service || '-' %>
    </div>

    <div class="row">
      <span class="label">How did you hear about us:</span>
      <%= heardAboutUs || '-' %>
    </div>

    <div class="row">
      <span class="label">Intent:</span>
      <%= intent || '-' %>
    </div>

    <div class="row">
      <span class="label">Message:</span><br>
      <%= message || '-' %>
    </div>

    <hr />

    <div class="row">
      Submitted On: <%= createdAt %>
    </div>
  </div>
</body>

</html>