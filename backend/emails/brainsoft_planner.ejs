<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f7fa; }
    .card { max-width: 750px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; }
    .title { font-size: 20px; font-weight: bold; color: #2c3e50; margin-bottom: 15px; }
    .row { margin: 8px 0; }
    .label { font-weight: bold; }
    .box { background: #f9f9f9; padding: 10px; border-radius: 4px; }
    ul { padding-left: 20px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="title">BrainSoft Project Planner Submission</div>

    <div class="row"><span class="label">Name:</span> <%= name || '-' %></div>
    <div class="row"><span class="label">Email:</span> <%= email || '-' %></div>
    <div class="row"><span class="label">Phone:</span> <%= phone || '-' %></div>
    <div class="row"><span class="label">Heard About Us:</span> <%= hearAboutUs || '-' %></div>
    <div class="row"><span class="label">Service Name:</span> <%= serviceName || '-' %></div>
    <div class="row"><span class="label">Project Type:</span> <%= projectType || '-' %></div>

    <div class="row">
      <span class="label">Selected Features:</span>
      <div class="box">
        <ul>
          <% (selectedFeatures || []).forEach(function(feature){ %>
            <li><%= feature %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <div class="row">
      <span class="label">Message:</span>
      <div class="box"><%= message || '-' %></div>
    </div>

    <hr/>
    <div class="row">Submitted On: <%= createdAt %></div>
  </div>
</body>
</html>
