<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f5f5; }
    .card { max-width: 700px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; }
    .title { font-size: 20px; font-weight: bold; margin-bottom: 15px; }
    .row { margin: 8px 0; }
    .label { font-weight: bold; }
    .box { background: #f9f9f9; padding: 10px; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="title">BrainTel Job Application</div>

    <div class="row"><span class="label">Name:</span> <%= fullName %></div>
    <div class="row"><span class="label">Email:</span> <%= email %></div>
    <div class="row"><span class="label">Phone:</span> <%= phone %></div>
    <div class="row"><span class="label">Position:</span> <%= position %></div>

    <div class="row">
      <span class="label">Cover Letter:</span>
      <div class="box"><%= coverLetter || '-' %></div>
    </div>

    <div class="row">
      <span class="label">Resume:</span>
      <div class="box">
        <% if (resumePath) { %>
      <div><strong>File:</strong> <%= resumeFile %></div>
    <% } else { %>
      No resume uploaded
    <% } %>
      </div>
    </div>

    <hr/>
    <div class="row">Submitted On: <%= createdAt %></div>
  </div>
</body>
</html>
